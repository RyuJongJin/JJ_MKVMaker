// 시작 프로그램의 아이콘 · 버전 정보
#include <windows.h>

1 ICON "..\\runner\\resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041204b0"
        BEGIN
            VALUE "CompanyName", "RyuJongJin"
            VALUE "FileDescription", "JJ_MKVMaker"
            VALUE "InternalName", "jj_mkvmaker"
            VALUE "OriginalFilename", "jj_mkvmaker.exe"
            VALUE "ProductName", "JJ_MKVMaker"
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x412, 1200
    END
END
